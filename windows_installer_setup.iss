; Script generated by Inno Setup Script Wizard for UNNAT ERP 9+ (Enterprise Edition)
#define MyAppName "UNNAT ERP 9+ (Enterprise Edition)"
#define MyAppVersion "9.5.0"
#define MyAppPublisher "UNNAT TECHNOLOGIES"
#define MyAppURL "https://unnat.tech"
#define MyAppExeName "unnat_erp.exe"

[Setup]
AppId={{D37E88A1-4265-4BF5-9E90-UNNATERP2026}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\UNNAT_ERP_9_PLUS
DisableProgramGroupPage=yes
LicenseFile=
OutputDir=build\installer
OutputBaseFilename=UNNAT_ERP_9_Plus_Enterprise_Setup
SetupIconFile=windows\runner\resources\app_icon.ico
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
PrivilegesRequired=lowest

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
; Grab all release output from Flutter build
Source: "build\windows\x64\runner\Release\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
